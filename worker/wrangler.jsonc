{
  "name": "onse-studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // ---------- D1 database ----------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-db",
      // Replace with your actual D1 database ID after running:
      //   wrangler d1 create studio-db
      "database_id": "9fbabcf2-2418-4532-b5b0-920343ee1a46",
      "migrations_dir": "migrations"
    }
  ],

  // ---------- R2 bucket ----------
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Replace with your actual bucket name after running:
      //   wrangler r2 bucket create onse-studio-files
      "bucket_name": "onse-studio-files",
      "preview_bucket_name": "onse-studio-files-preview"
    }
  ],

  // ---------- Environment variables ----------
  // Set secrets with: wrangler secret put JWT_SECRET
  // Set secrets with: wrangler secret put GMAIL_USER
  // Set secrets with: wrangler secret put GMAIL_APP_PASSWORD
  "vars": {
    // Public URL of the frontend (used in email links)
    "FRONTEND_URL": "https://studio.brigadaonse.org",
    // CORS origin — same as FRONTEND_URL in production
    "CORS_ORIGIN": "https://studio.brigadaonse.org"
  }

  // Secrets (never put real values here — use wrangler secret put):
  // JWT_SECRET        — random 64-char string for signing session tokens
  // GMAIL_USER        — your Gmail address, e.g. you@gmail.com
  // GMAIL_APP_PASSWORD — 16-char Gmail App Password (not your main password)
}
